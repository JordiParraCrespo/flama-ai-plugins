{
  "id": "posthog",
  "flama": "0.0.0",
  "feature": {
    "title": "PostHog analytics",
    "summary": "The PostHog adapters behind the kernel's analytics port — `createPostHogClient` in each app's own `posthog.ts`, which its `flama.ts` passes to `FlamaApp.create({ analytics })` and which reads `VITE_POSTHOG_KEY` / `EXPO_PUBLIC_POSTHOG_KEY`; without them every event goes to the no-op client",
    "identifiers": [
      "PostHog",
      "posthog-js",
      "posthog-react-native",
      "posthog.com",
      "createPostHogClient",
      "VITE_POSTHOG_KEY",
      "VITE_POSTHOG_HOST",
      "EXPO_PUBLIC_POSTHOG_KEY",
      "EXPO_PUBLIC_POSTHOG_HOST"
    ],
    "paths": [
      "apps/mobile/lib/posthog.ts",
      "apps/mobile/types/posthog-env.d.ts",
      "apps/web/src/lib/posthog.ts",
      "apps/web/src/types/posthog-env.d.ts"
    ],
    "slots": {
      ".env.example": [
        "mobile-env",
        "web-env"
      ],
      "apps/mobile/lib/flama.ts": [
        "app-config",
        "app-imports"
      ],
      "apps/web/src/lib/flama.ts": [
        "app-config",
        "app-imports"
      ],
      "scripts/check-frontend-structure.mjs": [
        "app-config-files"
      ]
    },
    "json": [
      {
        "file": "apps/web/package.json",
        "path": [
          "dependencies"
        ],
        "set": {
          "posthog-js": "^1.432.0"
        },
        "setAt": [
          18
        ],
        "needs": "web"
      },
      {
        "file": "apps/mobile/package.json",
        "path": [
          "dependencies"
        ],
        "set": {
          "posthog-react-native": "^4.11.2"
        },
        "setAt": [
          38
        ],
        "needs": "mobile"
      }
    ]
  },
  "files": {
    "apps/mobile/lib/posthog.ts": "files/apps/mobile/lib/posthog.ts",
    "apps/mobile/types/posthog-env.d.ts": "files/apps/mobile/types/posthog-env.d.ts",
    "apps/web/src/lib/posthog.ts": "files/apps/web/src/lib/posthog.ts",
    "apps/web/src/types/posthog-env.d.ts": "files/apps/web/src/types/posthog-env.d.ts"
  },
  "filesNeed": {
    "apps/mobile/lib/posthog.ts": "mobile",
    "apps/mobile/types/posthog-env.d.ts": "mobile",
    "apps/web/src/lib/posthog.ts": "web",
    "apps/web/src/types/posthog-env.d.ts": "web"
  },
  "blocks": [
    {
