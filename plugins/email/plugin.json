{
  "id": "email",
  "flama": "0.0.0",
  "feature": {
    "title": "Email delivery (SMTP and Resend)",
    "summary": "Two email drivers beside the kernel's `console` one, each cleanly separable: SMTP through nodemailer (`apps/api/src/config/nodemailer-email.service.ts`, `EMAIL_PROVIDER=nodemailer`, its `smtp` config section and `SMTP_*` settings) and Resend (`apps/api/src/config/resend-email.service.ts`, `EMAIL_PROVIDER=resend`, its `resend` config section and `RESEND_API_KEY`), in the API's email drivers, with the `email_delivery` capability. To keep only one, delete the other's two files, its import and row in `config/email.config.ts`, its section in `config/index.ts`, its line in the `email_delivery` capability and its case in that capability's spec, its `.env.example` lines and its dependency (`nodemailer` + `@types/nodemailer`, or `resend`)",
    "identifiers": [
      "SMTP",
      "Nodemailer",
      "nodemailer",
      "NodemailerEmailService",
      "nodemailer-email.service",
      "@types/nodemailer",
      "smtpConfig",
      "smtp.config",
      "Resend",
      "resend",
      "ResendEmailService",
      "resend-email.service",
      "resendConfig",
      "resend.config",
      "email_delivery",
      "SMTP_HOST",
      "SMTP_PORT",
      "SMTP_USER",
      "SMTP_PASS",
      "RESEND_API_KEY"
    ],
    "paths": [
      "apps/api/src/capabilities/__tests__/email-delivery.capability.spec.ts",
      "apps/api/src/config/nodemailer-email.service.ts",
      "apps/api/src/config/resend-email.service.ts",
