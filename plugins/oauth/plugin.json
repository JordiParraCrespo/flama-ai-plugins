      ],
      "packages/shared/src/types/deployment-capabilities.ts": [
        "client-capabilities"
      ],
      "scripts/check-frontend-structure.mjs": [
        "app-config-files"
      ]
    },
    "regenerate": [
      "generate:api-client",
      "generate:openapi"
    ]
  },
