{
  "id": "qa",
  "flama": "0.0.0",
  "feature": {
    "title": "QA scenario pack",
    "summary": "qa/ — scenario-driven Playwright QA pack with maturity tracking and screenshots",
    "identifiers": [
      "@flama/qa",
      "qa/"
    ],
    "paths": [
      "qa",
      "plans",
      "docs/screenshots"
    ],
    "requires": [
      "web",
      "admin-web",
      "e2e"
    ],
    "scripts": [
      "qa",
      "qa:suite",
      "qa:coverage"
    ],
    "json": [
      {
        "file": "biome.json",
        "path": [
          "files",
          "includes"
        ],
        "remove": [
          "!**/qa/artifacts"
        ],
        "at": [
          12
        ]
      },
      {
        "file": "package.json",
        "path": [
          "scripts"
        ],
        "set": {
          "qa": "pnpm --filter @flama/qa qa",
          "qa:suite": "pnpm --filter @flama/qa suite",
          "qa:coverage": "pnpm --filter @flama/qa coverage"
        },
        "setAt": [
          19,
          20,
          21
        ]
      }
    ]
  },
  "files": {
    "qa": "files/qa",
    "plans": "files/plans",
    "docs/screenshots": "files/docs/screenshots"
  },
  "blocks": [
    {
      "file": ".gitignore",
      "anchor": "qa",
      "source": "blocks/_gitignore.txt"
    },
    {
      "file": "pnpm-workspace.yaml",
      "anchor": "qa",
      "source": "blocks/pnpm-workspace_yaml.txt"
    }
  ]
}
